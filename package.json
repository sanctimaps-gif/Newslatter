{
  "name": "sanctimaps-newsletter-studio",
  "private": true,
  "version": "0.1.0",
  "description": "SanctiMaps Newsletter Studio — plateforme privée de gestion de newsletters",
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "worker",
    "frontend"
  ],
  "scripts": {
    "db:migrate": "npm run migrate -w backend",
    "db:seed": "npm run seed -w backend",
    "admin:create": "tsx backend/src/scripts/create-admin.ts",
    "dev:api": "npm run dev -w backend",
    "dev:worker": "npm run dev -w worker",
    "dev:web": "npm run dev -w frontend",
    "dev:mail": "node scripts/mail-catcher.mjs",
    "build": "npm run build -w frontend && npm run typecheck -w backend && npm run typecheck -w worker",
    "test": "npm run test -w backend && npm run test -w frontend",
    "pages": "node scripts/publish-pages.mjs",
    "google:build": "node google/build.mjs",
    "google:test": "cd google && vitest run test/script.test.mjs"
  },
  "devDependencies": {
    "mailparser": "^3.14.5",
    "smtp-server": "^3.21.6"
  }
}