{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "types": ["vite/client"],
    "paths": { "@shared/*": ["../shared/src/*"] }
  },
  "include": ["src", "../shared/src"],
  "exclude": ["src/**/*.test.tsx", "src/test-setup.ts"]
}
