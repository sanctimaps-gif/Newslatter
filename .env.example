# ─── SanctiMaps Newsletter Studio — copiez ce fichier en .env ───
# Ne jamais committer le fichier .env. En production, utilisez les secrets de l'hébergeur.

NODE_ENV=development
# URL publique de la plateforme (liens de confirmation, désinscription, images)
PUBLIC_URL=http://localhost:5173
API_PORT=3000

# Base PostgreSQL
DATABASE_URL=postgres://newsletter:CHANGER_MOI@localhost:5432/newsletter

# Secret aléatoire (64 caractères hexadécimaux minimum) : openssl rand -hex 32
APP_SECRET=

# Clé publique du formulaire du site principal (droits : inscription uniquement)
PUBLIC_SITE_KEY=pk_sanctimaps_CHANGER
# Origines autorisées à appeler l'API d'inscription (séparées par des virgules)
CORS_ORIGINS=https://sanctimaps.fr,https://www.sanctimaps.fr

# ─── SMTP (aucune valeur inventée : à compléter avec votre fournisseur) ───
SMTP_HOST=
SMTP_PORT=587
# "starttls" (587), "tls" (465) ou "none" (boîte de test locale uniquement)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Mode bac à sable : true = tous les messages vont vers la boîte de test locale, rien ne sort
MAIL_SANDBOX=true

# Secret partagé pour le webhook de rebonds/plaintes du relais SMTP
BOUNCE_WEBHOOK_SECRET=

# Fuseau horaire par défaut
DEFAULT_TIMEZONE=Europe/Paris
